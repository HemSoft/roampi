{
  "$schema": "../roampi.schema.json",
  "version": 1,
  "kind": "machine",
  "machine": {
    "homeHost": {
      "id": "home",
      "name": "Home Mac",
      "host": "home.example.test",
      "port": 22,
      "username": "operator",
      "visible": true
    },
    "machines": [],
    "projects": [
      {
        "id": "declared",
        "machineID": "home",
        "path": "/srv/declared",
        "name": "Declared",
        "visible": true,
        "discovery": "session"
      }
    ],
    "projectOverrides": [],
    "fallbackBehavior": "includeDiscovered"
  },
  "pages": [],
  "dataSources": [],
  "actions": [],
  "jobs": []
}
