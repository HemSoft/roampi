{
  "$schema": "../roampi.schema.json",
  "version": 1,
  "kind": "machine",
  "machine": {
    "homeHost": {
      "id": "home",
      "name": "Home Mac",
      "host": "home.example.test",
      "port": 22,
      "username": "operator",
      "visible": true
    },
    "machines": [],
    "projects": [],
    "projectOverrides": [],
    "fallbackBehavior": "includeDiscovered"
  },
  "pages": [
    {
      "id": "nested-page",
      "title": "Nested",
      "blocks": [
        {
          "id": "section",
          "type": "section",
          "layout": {
            "compactSpan": 12,
            "regularSpan": 12
          },
          "blocks": [
            {
              "id": "duplicate-child",
              "type": "markdown",
              "layout": {
                "compactSpan": 12,
                "regularSpan": 12
              },
              "blocks": [],
              "content": "One"
            },
            {
              "id": "duplicate-child",
              "type": "markdown",
              "layout": {
                "compactSpan": 12,
                "regularSpan": 12
              },
              "blocks": [],
              "content": "Two"
            }
          ]
        }
      ],
      "children": []
    }
  ],
  "dataSources": [],
  "actions": [],
  "jobs": []
}
